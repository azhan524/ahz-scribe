<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AhzScribe.Net10</AssemblyName>
    <RootNamespace>AhzScribe</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>..\..\src\app.manifest</ApplicationManifest>
    <NoWarn>CS0618;CS0649;CS0169;CS0414;CS1690;SYSLIB0011;SYSLIB0021;WFO1000;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\AhzScribe.cs" Link="AhzScribe.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CefSharp.WinForms.NETCore" Version="154.0.340" />
    <PackageReference Include="Scintilla.NET" Version="5.3.2.9" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\browser-home.html" Link="browser-home.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\app.ico" Link="app.ico" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\src\app.ico')" />
    <None Include="..\..\plugins\market.json" Link="plugins\market.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\plugins\market.json')" />
  </ItemGroup>
</Project>
